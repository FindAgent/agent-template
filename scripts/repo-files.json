{
  "$comment": "The one definition of a complete code-agent repository. scripts/init_agent.py creates these, scripts/check_repo_files.py verifies them.",
  "all": [
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
